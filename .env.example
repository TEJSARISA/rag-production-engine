# GROQ_API_KEY=gsk_your_groq_api_key_here
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# Security
JWT_SECRET=super-secret-jwt-key-change-in-production
API_KEY=super-secret-api-key
